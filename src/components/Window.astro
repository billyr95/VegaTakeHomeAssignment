---
interface Props { label?: string; class?: string; closable?: boolean }
const { label = '', class: cls, closable = false } = Astro.props;
---
<div class:list={['window', cls]}>
  <div class="bar">
    <span class="label">{label}</span>
    <span class="ctl">
      <i aria-hidden="true"></i><i aria-hidden="true"></i>
      {closable
        ? <button type="button" class="close" data-close aria-label="Close"></button>
        : <i aria-hidden="true"></i>}
    </span>
  </div>
  <div class="body"><slot /></div>
</div>

<style>
  .window { position: relative; z-index: 2; background: var(--paper); border: 1.5px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); }
  .bar { display: flex; justify-content: space-between; align-items: center; min-height: 26px; padding: 4px 10px; border-bottom: 1.5px solid var(--ink); font-family: var(--mono); font-size: 12px; }
  .ctl { display: flex; gap: 5px; margin-left: auto; }
  .ctl i, .close { width: 11px; height: 11px; border: 1.5px solid var(--ink); }

  .close { position: relative; padding: 0; background: #E4405B; cursor: pointer; }
  .close::before { content: ''; position: absolute; inset: -11px; }
  .close:hover, .close:focus-visible { background: #B8243D; }
  .body { padding: clamp(20px, 4vw, 48px); }
</style>
