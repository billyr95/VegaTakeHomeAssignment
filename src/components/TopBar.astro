---

import { event } from '../data/content';
---
<header class="topbar" data-topbar>
  <a class="logo" href="https://vega.io" aria-label="Vega home"><img src="/vega-logo.svg" alt="Vega" width="340" height="146" /></a>
  <a class="demo" href={event.registerUrl} data-register>Register</a>
</header>

<style>
  .topbar {
    position: fixed; z-index: 50;
    top: max(12px, env(safe-area-inset-top, 0px));

    left: max(12px, env(safe-area-inset-left, 0px), calc((100vw - 1400px) / 2)); right: max(12px, env(safe-area-inset-right, 0px), calc((100vw - 1400px) / 2));
    height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 7px 0 20px;
    background: var(--paper); border: 1.5px solid var(--ink); box-shadow: 4px 4px 0 var(--ink);
  }
  .logo { display: flex; align-items: center; height: 100%; }
  .logo img { height: 19px; width: auto; display: block; }
  .demo {
    display: inline-flex; align-items: center; min-height: 38px; padding: 0 16px;
    background: var(--yellow); color: var(--ink); font-family: var(--mono); font-size: 14px; text-decoration: none;
  }
  .demo:hover { background: #FFC400; }
  @media (max-width: 767px) {
    .topbar { height: 48px; padding: 0 6px 0 16px; }
    .logo img { height: 17px; }
    .demo { min-height: 34px; padding: 0 12px; font-size: 13px; }
  }
</style>
