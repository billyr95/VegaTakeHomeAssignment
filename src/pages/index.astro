---
import Base from '../layouts/Base.astro';
import Cloud from '../components/Cloud.astro';
import Window from '../components/Window.astro';
import Art from '../components/Art.astro';
import Street from '../components/Street.astro';
import Sky from '../components/Sky.astro';
import HeroSky from '../components/HeroSky.astro';
import TopBar from '../components/TopBar.astro';
import RegisterDialog from '../components/RegisterDialog.astro';
import { event, sessions } from '../data/content';
---
<Base title={`${event.name} — ${event.dates}, ${event.venue}`} description={event.tagline}>
  <Sky />
  <TopBar />
  <main>
    <section class="hero" aria-labelledby="title">
      <HeroSky />
      <Cloud n={1} scale={3} x="-16%" y="-80px" />
      <Cloud n={2} scale={4} x="52%" y="-50px" />
      <Cloud n={5} scale={3} x="66%" y="44%" />
      <Cloud n={3} scale={2} x="4%" y="30%" />
      <Cloud n={4} scale={2} x="34%" y="10%" />
      <Cloud n={3} scale={3} x="-4%" y="78%" front />

      <Window class="hero-window">
          <i class="card-mole" aria-hidden="true"></i>
          <p class="card-mole-say" data-mole-say role="status" hidden>How did I even get up here?</p>
        <h1 id="title">{event.name}</h1>
        <p class="tagline">{event.tagline}</p>
        <div class="meta">
          <span>{event.dates}</span>
          <span>{event.venue}</span>
          <a class="btn" href={event.registerUrl} data-register>Register now</a>
        </div>
      </Window>
    </section>

    <section class="schedule" aria-labelledby="schedule-h">
      <div class="pin" data-hscroll>
        <div class="stage">
          <div class="banner">
            <h2 id="schedule-h" class="banner-text">Schedule</h2>
          </div>
          <div class="track" data-track>
            <Cloud n={5} scale={3} x="6%" y="84%" hspeed={0.35} flip />
            <Cloud n={1} scale={2} x="46%" y="80%" hspeed={0.25} />
            <Cloud n={2} scale={3} x="86%" y="86%" hspeed={0.5} />
            <Cloud n={4} scale={2} x="28%" y="34%" hspeed={1.35} front />
            <Cloud n={5} scale={1} x="74%" y="60%" hspeed={1.55} front />
            <Cloud n={3} scale={2} x="2%" y="22%" hspeed={0.55} />
            <Cloud n={2} scale={2} x="20%" y="12%" hspeed={0.4} flip />
            <Cloud n={1} scale={1} x="40%" y="24%" hspeed={0.7} />
            <Cloud n={4} scale={2} x="55%" y="9%" hspeed={0.5} />
            <Cloud n={5} scale={2} x="66%" y="26%" hspeed={0.8} flip />
            <Cloud n={3} scale={1} x="80%" y="16%" hspeed={1.2} />
            <Cloud n={2} scale={2} x="90%" y="28%" hspeed={0.6} />
            <div class="sam-hop idle" data-hop aria-hidden="true"></div>
            <ol class="islands">
              {sessions.map((s, i) => (
                <li class="island" id={s.id} style={`--w:${s.w}`} data-w={s.w} data-ground={s.ground}>
                  <div class="art-wrap">
                    <Art src={s.art} label={s.art.replace('/art/', '')} ratio="4 / 3" />
                  </div>
                  <Window class="session">
                    <p class="time"><span class="clock">{s.time}</span><span class="mer">{s.meridiem}</span></p>
                    <p class="title">{s.title}</p>
                  </Window>
                </li>
              ))}
            </ol>
          </div>
          <div class="progress" aria-hidden="true">
            {sessions.map((_, i) => <i data-dot data-on={i === 0 ? '' : undefined}></i>)}
            <span data-count>1 / {sessions.length}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="arrival" aria-labelledby="booth-h">
      <Cloud n={5} scale={3} x="42%" y="-40px" flip />
      <Cloud n={3} scale={2} x="-4%" y="80px" />
      <Street>
        <Window class="booth-window">
          <h2 id="booth-h">Find us at {event.booth}</h2>
          <a class="btn" href={event.registerUrl} data-register>Register now</a>
        </Window>
      </Street>
    </section>
  </main>

  <RegisterDialog />

  <script>import '../scripts/motion.ts';</script>
  <script>

    const say = document.querySelector<HTMLElement>('[data-mole-say]');
    const card = document.querySelector<HTMLElement>('.hero-window');
    if (say && card) {
      let done = false;
      const io = new IntersectionObserver((es) => {
        if (done || !es.some((e) => e.isIntersecting)) return;
        done = true; io.disconnect();
        setTimeout(() => { say.hidden = false; setTimeout(() => { say.hidden = true; }, 4500); }, 2000);
      }, { threshold: 0.6 });
      io.observe(card);
    }
  </script>
</Base>

<style>

  .hero { position: relative; min-height: 100svh; display: grid; place-items: center; padding: 180px 20px 160px; overflow-x: clip; overflow-y: visible; }
  .hero :global(.hero-window) { width: min(620px, 100%); text-align: center; }
  h1 { margin: 0; font-family: var(--pixel); font-weight: 400; font-size: clamp(52px, 8vw, 92px); line-height: 1; }
  .tagline { margin: 14px auto 0; max-width: 32ch; color: var(--muted); font-size: 15px; line-height: 1.45; }
  .meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 22px; margin-top: 26px; font-size: 15px; }

  .schedule { position: relative; z-index: 1; }

  .banner { position: absolute; z-index: 4; left: 50%; top: 112px; width: max-content; transform: translateX(-50%); }
  .banner-text { margin: 0; font-family: var(--pixel); font-weight: 400; font-size: clamp(40px, 6vw, 72px); line-height: 1; color: var(--ink); }
  .pin { position: relative; }
  .stage { position: sticky; top: 0; height: 100svh; overflow-x: clip; overflow-y: visible; }
  .track { position: relative; height: 100%; width: max-content; display: flex; align-items: center; padding: 210px 12vw 76px; will-change: transform; }

  .islands { position: relative; z-index: 1; display: flex; align-items: flex-start; gap: 10vw; margin: 0; padding: 0; list-style: none; }

  .island { position: relative; display: flex; flex-direction: column-reverse; align-items: center; width: min(calc(var(--w) * 2px), 44vw, calc((100svh - 490px) * 1.3)); }
  .art-wrap { position: relative; width: 100%; }
  .island :global(.session) { width: min(100%, 420px); margin-bottom: 18px; text-align: center; }

  .sam-hop { --sz: 120px; position: absolute; z-index: 2; left: 0; top: 0; width: var(--sz); height: var(--sz);
    background: url('/sprites/idle.png') 0 0 / auto 100% no-repeat; image-rendering: pixelated; will-change: transform; pointer-events: none; }
  .sam-hop.idle { animation: hop-idle 3.3s steps(33) infinite; }
  .sam-hop.run  { background-image: url('/sprites/run.png'); animation: hop-run .42s steps(4) infinite; }
  .sam-hop.jump { background-image: url('/sprites/jump.png'); animation: none; background-position: 0 0; }
  @keyframes hop-idle { to { background-position-x: calc(var(--sz) * -33); } }
  @keyframes hop-run  { to { background-position-x: calc(var(--sz) * -4); } }
  @media (prefers-reduced-motion: reduce) { .sam-hop { display: none; } }
  .island :global(.session .body) { padding: 14px 18px 18px; }
  .time { margin: 0; display: flex; justify-content: center; align-items: baseline; gap: 6px; }
  .clock { font-family: var(--pixel); font-size: clamp(40px, 4.4vw, 60px); line-height: 1; }
  .mer { font-family: var(--pixel); font-size: 20px; }
  .title { margin: 6px 0 0; font-size: clamp(16px, 1.5vw, 20px); }
  .progress { position: absolute; z-index: 5; left: 50%; bottom: 28px; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; padding: 7px 10px; font-family: var(--mono); font-size: 12px; background: var(--paper); border: 1.5px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); }
  .progress i { width: 26px; height: 6px; background: rgba(11, 31, 11, .2); }
  .progress i[data-on] { background: var(--ink); }
  .progress span { margin-left: 6px; }

  .arrival { position: relative; padding-top: 30vh; overflow-x: clip; }
  .arrival :global(.booth-window) { width: min(560px, 100%); text-align: center; }

  .card-mole {
    --m: 120px; position: absolute; right: 9%; bottom: calc(100% - 3px); width: var(--m); height: var(--m);
    background: url('/sprites/mole-sit.png') 0 0 / 2800% 100% no-repeat; image-rendering: pixelated;
    animation: card-mole 3.2s steps(28, end) infinite;
  }

  @keyframes card-mole { to { background-position-x: 103.7037%; } }

  .card-mole-say {
    position: absolute; right: calc(9% + var(--m, 120px) * .82); bottom: calc(100% + 54px); width: max-content; max-width: 220px; margin: 0;
    padding: 9px 12px; background: var(--paper); border: 1.5px solid var(--ink); box-shadow: 4px 4px 0 var(--ink);
    font-family: var(--pixel); font-size: 17px; line-height: 1.15; text-align: left; animation: say-in .25s steps(4, end) both;
  }
  .card-mole-say::after { content: ''; position: absolute; left: 100%; bottom: 8px; width: 10px; height: 10px; background: var(--ink);
    clip-path: polygon(0 0, 40% 0, 40% 33%, 70% 33%, 70% 66%, 100% 66%, 100% 100%, 0 100%); }
  @keyframes say-in { from { opacity: 0; translate: 0 6px; } }
  @media (max-width: 767px) {
    .card-mole { --m: 90px; right: 6%; }
    .card-mole-say { right: calc(6% + 90px * .82); bottom: calc(100% + 38px); font-size: 15px; max-width: 170px; }
  }
  @media (prefers-reduced-motion: reduce) { .card-mole, .card-mole-say { animation: none; } }
  .arrival h2 { margin: 0 0 18px; font-family: var(--pixel); font-weight: 400; font-size: clamp(32px, 4vw, 48px); line-height: 1.05; }

  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .stage { position: relative; height: auto; overflow: visible; }
    .track { width: auto; display: block; padding: 40px 20px 80px; transform: none !important; }
    .islands { flex-direction: column; align-items: center; gap: 56px; }
    .island { width: min(100%, calc(var(--w) * 1px)); }
    .island :global(.session) { width: min(100%, 340px); }
    .banner { position: relative; left: auto; top: auto; transform: none; margin: 0 auto 24px; }
    .track { padding-top: 24px; }
    .progress { display: none; }
    .track :global(.cloud:not(.front)) { display: none; }
    .track :global(.cloud.front) { z-index: 0; }
  }
</style>
